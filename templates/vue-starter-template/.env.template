# Template for Nuxt public runtime config.
# Copy or rename this file to `.env` (or inject these as env vars) to override nuxt.config.ts defaults.
# https://developer.shopwell.cn/frontends/getting-started/templates.html

# Your Shopwell 6 Store API endpoint
# https://developer.shopwell.cn/frontends/installation.html
NUXT_PUBLIC_SHOPWELL_ENDPOINT=https://demo-frontends.shopwell.store/store-api/

# Sales Channel access token (Settings > Sales Channel > API access in Shopwell admin)
# https://developer.shopwell.cn/frontends/installation.html
NUXT_PUBLIC_SHOPWELL_ACCESS_TOKEN=SWSCNWDGMUWZM0TLVUU0YKLQVW

# Storefront domain registered in your Sales Channel (Settings > Sales Channel > Domains).
# Registration, newsletter and password recovery send it as storefrontUrl, and Shopwell
# rejects any value that is not a listed domain. localhost never is, so set it for local
# development. The public demo backend lists exactly this one domain.
# In production, leave it empty: window.location.origin is used.
NUXT_PUBLIC_SHOPWELL_DEV_STOREFRONT_URL=https://demo-frontends.shopwell.store/figma

# Optional private SSR endpoint. Set this only if server-side requests should
# use a different internal URL than the public browser endpoint.
NUXT_SHOPWELL_ENDPOINT=

# Optional public URL of the storefront, e.g. https://your-shop.com.
# /sitemap.xml builds its links from it. Without it, the request host is used,
# which is wrong behind a proxy that rewrites the Host header.
NUXT_PUBLIC_SITE_URL=

# Type generation (development only) — used by `pnpm generate-types` (@shopwell/api-gen)
# https://developer.shopwell.cn/frontends/packages/api-client.html

# Base URL of your Shopwell instance (without /store-api/ suffix)
OPENAPI_JSON_URL=https://demo-frontends.shopwell.store

# Sales Channel access key for fetching the OpenAPI schema
OPENAPI_ACCESS_KEY=
