{
  "name": "docs",
  "private": true,
  "version": "1.10.5",
  "description": "",
  "type": "module",
  "scripts": {
    "docs:env": "if [ -x \"../../../developer-portal/docs-cli.cjs\" ]; then ../../../developer-portal/docs-cli.cjs pull; else echo \"Provide ../../../developer-portal/docs-cli.cjs before running docs:env\" >&2; exit 1; fi",
    "docs:link": "../../../developer-portal/docs-cli.cjs link --src apps/docs/src --dst frontends --symlink --keep",
    "docs:preview": "../../../developer-portal/docs-cli.cjs preview",
    "docs:cli": "../../../developer-portal/docs-cli.cjs",
    "schema:update": "pnpm run schema:update:store && pnpm run schema:update:admin",
    "schema:update:admin": "cp ../../packages/api-client/api-types/adminApiSchema.json src/.data/schema/adminApiSchema.json",
    "schema:update:store": "cp ../../packages/api-client/api-types/storeApiSchema.json src/.data/schema/storeApiSchema.json"
  },
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  },
  "devDependencies": {
    "ts-dox": "^0.1.0",
    "vitepress": "^1.4.0",
    "vinyl": "^3.0.0"
  }
}
