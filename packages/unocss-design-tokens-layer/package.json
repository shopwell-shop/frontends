{
  "name": "@shopwell/unocss-design-tokens-layer",
  "version": "1.0.2",
  "description": "Reusable Nuxt Layer for Shopwell design tokens and UnoCSS configuration",
  "author": "Shopwell",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shopwell-shop/frontends.git"
  },
  "homepage": "https://developer.shopwell.cn/frontends/",
  "keywords": [
    "Shopwell",
    "UnoCSS",
    "Nuxt",
    "Layer",
    "Design Tokens"
  ],
  "bugs": {
    "url": "https://github.com/shopwell-shop/frontends/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "./nuxt.config.ts",
  "exports": {
    ".": "./nuxt.config.ts",
    "./uno.config": "./uno.config.ts",
    "./uno.runtime.config": "./uno.runtime.config.ts"
  },
  "files": [
    "app",
    "nuxt.config.ts",
    "index.d.ts",
    "theme.ts",
    "uno.config.ts",
    "uno.runtime.config.ts"
  ],
  "scripts": {
    "lint": "oxlint . && oxfmt --check .",
    "lint:fix": "oxlint --fix . && oxfmt --write . && pnpm run typecheck",
    "typecheck": "pnpm nuxt prepare && tsgo --noEmit"
  },
  "dependencies": {
    "@iconify-json/carbon": "1.2.27",
    "@unocss/nuxt": "66.10.5",
    "@unocss/core": "66.10.5",
    "@unocss/preset-wind3": "66.10.5",
    "@unocss/runtime": "66.10.5",
    "unocss": "66.10.5"
  },
  "devDependencies": {
    "@nuxt/schema": "4.5.2",
    "@typescript/native-preview": "7.0.0-dev.20260205.1",
    "nuxt": "4.5.2",
    "typescript": "5.9.3",
    "unbuild": "3.6.1"
  }
}
